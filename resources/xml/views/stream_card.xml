<!--
    One video card.

    Every box in here has a fixed height on purpose. The old card let the title
    grow to however many lines it wanted, which made each card a different
    height, so cards in the same row no longer lined up and the bottom row was
    cut off mid-sentence by the scrolling frame. Fixed heights keep the grid on
    a rhythm and guarantee nothing ever overflows the card.
-->
<brls:Box
    width="24%"
    height="236"
    axis="column"
    marginRight="10"
    padding="8"
    focusable="true"
    cornerRadius="10"
    highlightCornerRadius="12"
    backgroundColor="@theme/color/newpipe_card">

    <!--
        The thumbnail well holds the 16:9 hole open before the image arrives, so
        rows do not jump around as thumbnails stream in, and an image that never
        loads still reads as a deliberate placeholder.
    -->
    <brls:Box
        width="auto"
        height="132"
        cornerRadius="8"
        marginBottom="8"
        backgroundColor="@theme/color/newpipe_thumb">

        <brls:Image
            id="stream/thumbnail"
            width="100%"
            height="100%"
            scalingType="fill"
            cornerRadius="8" />

        <!-- Duration/LIVE pill, the way NewPipe and YouTube both place it. -->
        <brls:Box
            id="stream/badge"
            width="auto"
            height="auto"
            positionType="absolute"
            positionBottom="6"
            positionRight="6"
            paddingLeft="6"
            paddingRight="6"
            paddingTop="2"
            paddingBottom="2"
            cornerRadius="4"
            backgroundColor="#000000E6">

            <brls:Label
                id="stream/badge_text"
                width="auto"
                height="auto"
                singleLine="true"
                fontSize="12"
                textColor="#FFFFFF" />
        </brls:Box>
    </brls:Box>

    <!--
        Two single-line labels rather than one wrapping label: borealis can only
        wrap a label to whatever fits or collapse it to a single truncated line,
        it cannot clamp to exactly two lines. StreamCard splits the title
        itself, and each line ellipsises on its own - and scrolls the full text
        while the card is focused.
    -->
    <brls:Label
        id="stream/title_line1"
        width="auto"
        height="20"
        singleLine="true"
        fontSize="15"
        textColor="@theme/color/newpipe_text" />

    <brls:Label
        id="stream/title_line2"
        width="auto"
        height="20"
        singleLine="true"
        fontSize="15"
        textColor="@theme/color/newpipe_text" />

    <brls:Label
        id="stream/channel"
        width="auto"
        height="16"
        marginTop="4"
        singleLine="true"
        fontSize="12"
        textColor="@theme/color/newpipe_text_dim" />

    <brls:Label
        id="stream/meta"
        width="auto"
        height="15"
        marginTop="2"
        singleLine="true"
        fontSize="11"
        textColor="@theme/color/newpipe_text_faint" />

</brls:Box>
