<brls:AppletFrame
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="false">
    <brls:Box
            axis="column"
            width="100%"
            height="100%">

        <!-- Brand header: logo mark + name, pinned top-left like youtube.com -->
        <brls:Box
                width="auto"
                height="52"
                axis="row"
                alignItems="center"
                paddingLeft="24"
                paddingTop="8"
                paddingBottom="8"
                backgroundColor="@theme/color/newpipe_bg">

            <SVGImage
                    SVG="@res/svg/brand_logo.svg"
                    width="40"
                    height="28"/>

            <brls:Label
                    text="YouTube"
                    marginLeft="8"
                    fontSize="26"
                    textColor="@theme/color/newpipe_text"/>
        </brls:Box>

        <AutoTabFrame
                id="main/tabs"
                grow="1"
                tabBackgroundColor="@theme/color/newpipe_bg"
                tabItemActiveTextColor="@theme/color/newpipe"
                defaultTab="0"
                sidebarPosition="bottom">

            <Tab
                    label="@i18n/app/home"
                    icon="@res/svg/home.svg"
                    iconActivate="@res/svg/home_active.svg">
                <HomeTab/>
            </Tab>

            <Tab
                    label="@i18n/app/shorts"
                    icon="@res/svg/shorts.svg"
                    iconActivate="@res/svg/shorts_active.svg">
                <ShortsTab/>
            </Tab>

            <Tab
                    label="@i18n/app/search"
                    icon="@res/svg/search.svg"
                    iconActivate="@res/svg/search_active.svg">
                <SearchTab/>
            </Tab>

            <Tab
                    label="@i18n/app/subscriptions"
                    icon="@res/svg/subscriptions.svg"
                    iconActivate="@res/svg/subscriptions_active.svg">
                <SubscriptionsTab/>
            </Tab>

            <Tab
                    label="@i18n/app/library"
                    icon="@res/svg/library.svg"
                    iconActivate="@res/svg/library_active.svg">
                <LibraryTab/>
            </Tab>

            <Tab
                    label="@i18n/app/settings"
                    icon="@res/svg/settings.svg"
                    iconActivate="@res/svg/settings_active.svg">
                <SettingsTab/>
            </Tab>
        </AutoTabFrame>
    </brls:Box>
</brls:AppletFrame>
